{
  "name": "astro-theme-pure",
  "type": "module",
  "version": "4.1.6",
  "workspaces": [
    "packages/pure"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build": "astro-pure check && astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "astro": "astro",
    "pure": "astro-pure",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "bun lint && bun sync && bun check && bun format",
    "clean": "rm -rf .astro .vercel dist",
    "deploy": "bash scripts/deploy.sh",
    "backup": "bash scripts/backup.sh",
    "test:deploy": "node --test scripts/import-post.test.mjs",
    "cache:avatars": "bun preset/scripts/cacheAvatars.ts",
    "ui:sync": "bun run build && bun scripts/sync-site-ui.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/rss": "4.0.19",
    "@waline/client": "^3.16.0",
    "astro": "7.3.5",
    "astro-pure": "workspace:*",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "@astrojs/markdown-remark": "7.3.0",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "hastscript": "9.0.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "mdast-util-from-markdown": "2.0.3",
    "parse5": "7.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "postcss": "8.5.23",
    "postcss-selector-parser": "7.1.6",
    "yaml": "2.8.3"
  },
  "overrides": {
    "yaml": "^2.8.3",
    "http-cache-semantics": "^4.3.0",
    "source-map-js": "^1.2.2",
    "smol-toml": "^1.9.0",
    "postcss-selector-parser": "7.1.6"
  }
}
