---
import { type IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'

interface SubstatsItem {
  platform: string
  icon: IconsType
  color?: string
  link?: string
  text: string
  api?: string
  count?: number
  stale?: boolean
  updatedAt?: string
}

type Props = {
  stats: SubstatsItem[]
}

const { stats } = Astro.props as Props

async function fetchCount(item: SubstatsItem) {
  if (!item.api) return
  const bilibiliUid = /^bilibili\/(\d+)$/.exec(item.api)?.[1]
  const sources = [
    ...(bilibiliUid
      ? [{ url: `https://api.bilibili.com/x/relation/stat?vmid=${bilibiliUid}`, official: true }]
      : []),
    { url: `https://api.swo.moe/stats/${item.api}`, official: false }
  ]
  const errors: string[] = []
  for (const { url, official } of sources) {
    try {
      const response = await fetch(url, {
        headers: { Accept: 'application/json', 'Accept-Encoding': 'identity' },
        signal: AbortSignal.timeout(5_000)
      })
      if (!response.ok) throw new Error(`HTTP ${response.status}`)
      const data = await response.json()
      if (official ? data?.code !== 0 : data?.failed) {
        throw new Error(data?.message || 'API request failed')
      }
      const count = official ? data?.data?.follower : data?.count
      if (typeof count !== 'number' || !Number.isSafeInteger(count) || count < 0) {
        throw new Error('Invalid count')
      }
      item.count = count
      item.stale = false
      item.updatedAt = new Date().toISOString()
      return
    } catch (error) {
      errors.push(error instanceof Error ? error.message : String(error))
    }
  }
  item.stale = true
  console.warn(`[Substats] ${item.api}: ${errors.join('; ')}`)
}

await Promise.all(stats.map(fetchCount))
---

<div class='grid grid-cols-1 gap-3 rounded-xl border p-2 sm:grid-cols-2 sm:p-3'>
  {
    stats.map(({ link, platform, icon, color, count, text, stale, api, updatedAt }) => (
      <a
        class='group text-muted-foreground no-underline'
        href={link}
        target='_blank'
        rel='noopener noreferrer'
      >
        <div class='flex items-center gap-3 rounded-lg border border-transparent px-3 py-2 transition-all hover:border-border hover:bg-muted'>
          {icon && <Icon name={icon} color={color} />}
          <div class='flex-1 text-foreground transition-colors group-hover:text-primary'>
            {platform}
          </div>
          <div class='flex items-center gap-1.5'>
            <samp
              data-stat-key={api ? `account:${api}` : undefined}
              data-stat-value={count}
              data-stat-updated-at={updatedAt}
              title={
                count == null
                  ? 'Statistics temporarily unavailable'
                  : stale
                    ? 'Last known value; live statistics temporarily unavailable'
                    : undefined
              }
            >
              {count ?? '—'}
            </samp>
            <span class='text-sm font-normal'>{text}</span>
          </div>
        </div>
      </a>
    ))
  }
</div>
<div class='mt-2 text-right text-sm'>
  Powered by <a
    class='text-muted-foreground'
    href='https://github.com/spencerwooo/substats'
    target='_blank'
    rel='noopener noreferrer'>Substats</a
  >
</div>
