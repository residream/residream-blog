---
import { getLocale } from '@/utils/i18n'
import config from '@/site-config'

import '@waline/client/style'

import { cn } from 'astro-pure/utils'

const { class: className } = Astro.props
---

{
  config.integ.waline.enable && (
    <comment-component>
      <div
        id='waline'
        class={cn('not-prose', className)}
        data-hide-meta={!config.integ.waline.showMeta}
      >
        {getLocale(Astro.url) === 'en' ? 'Loading comments…' : '评论加载中…'}
      </div>
    </comment-component>
  )
}

<script>
  import type { WalineEmojiPresets, WalineInstance } from '@waline/client'
  import { commentCount } from '@waline/client/comment'
  import { pageviewCount } from '@waline/client/pageview'
  import config from 'virtual:config'

  import { getLocale, withoutLocale, type Locale } from '@/utils/i18n'

  const walineConfig = config.integ.waline
  // Counts are requested with the page, so readers who never reach the comments are still counted
  const { pageview, comment, ...walineOptions } = walineConfig.additionalConfigs
  const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)
  const message = (locale: Locale) =>
    local
      ? locale === 'en'
        ? 'Comments are disabled in the local preview.'
        : '本地预览暂不连接评论服务。'
      : locale === 'en'
        ? 'Loading comments…'
        : '评论加载中…'

  // A link to a single comment can only scroll once the comments are rendered
  const linksToComment = () => {
    try {
      const id = decodeURIComponent(location.hash.slice(1))
      return !!id && !document.getElementById(id)
    } catch {
      return false
    }
  }

  class Comment extends HTMLElement {
    instance: WalineInstance | null = null
    observer?: IntersectionObserver
    loading = false

    connectedCallback() {
      document.addEventListener('rd:language-change', this.updateLocale)
      if ((document as Document & { prerendering?: boolean }).prerendering) {
        document.addEventListener('prerenderingchange', this.start, { once: true })
      } else {
        this.start()
      }
    }

    disconnectedCallback() {
      document.removeEventListener('rd:language-change', this.updateLocale)
      document.removeEventListener('prerenderingchange', this.start)
      this.observer?.disconnect()
      this.observer = undefined
      this.instance?.destroy()
      this.instance = null
    }

    updateLocale = () => {
      const lang = getLocale(location.pathname)
      if (this.instance) {
        this.instance.update({ lang, path: withoutLocale(location.pathname) })
      } else if (!this.loading) {
        const element = this.querySelector('#waline')
        if (element) element.textContent = message(lang)
      }
    }

    start = () => {
      if (!this.isConnected || this.observer || this.instance) return
      if (local) {
        this.updateLocale()
        return
      }
      const serverURL = walineConfig.server || ''
      const path = withoutLocale(location.pathname)
      if (pageview)
        pageviewCount({
          serverURL,
          path,
          selector: typeof pageview === 'string' ? pageview : undefined
        })
      if (comment)
        commentCount({
          serverURL,
          path,
          selector: typeof comment === 'string' ? comment : undefined
        })
      if (linksToComment()) {
        void this.initialize()
        return
      }
      // The comment UI (Vue, about 70 KB gzip) loads once it is close to the viewport
      this.observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return
          this.observer?.disconnect()
          void this.initialize()
        },
        { rootMargin: '800px 0px' }
      )
      this.observer.observe(this.querySelector('#waline') ?? this)
    }

    initialize = async () => {
      if (!this.isConnected || this.instance || this.loading) return
      this.loading = true
      ;(globalThis as unknown as { __VUE_OPTIONS_API__: boolean }).__VUE_OPTIONS_API__ = true
      ;(globalThis as unknown as { __VUE_PROD_DEVTOOLS__: boolean }).__VUE_PROD_DEVTOOLS__ = false
      ;(
        globalThis as unknown as { __VUE_PROD_HYDRATION_MISMATCH_DETAILS__: boolean }
      ).__VUE_PROD_HYDRATION_MISMATCH_DETAILS__ = false

      try {
        const { init } = await import('@waline/client')
        if (!this.isConnected || this.instance) return
        // Served from public/emojis. Absolute, because Waline stores the image addresses in each
        // comment, which its admin pages and notification emails show outside this site
        const emoji = walineConfig.emoji?.map(
          (preset) => new URL(`/emojis/${preset}`, location.origin).href as WalineEmojiPresets
        )
        this.instance = init({
          el: 'comment-component #waline',
          serverURL: walineConfig.server || '',
          emoji,
          reaction: ['/icons/heart-item.svg'],
          ...walineOptions,
          lang: getLocale(location.pathname),
          path: withoutLocale(location.pathname)
        })
      } catch {
        const element = this.querySelector('#waline')
        if (element)
          element.textContent =
            getLocale(location.pathname) === 'en'
              ? 'Comments failed to load. Try refreshing the page.'
              : '评论加载失败，请刷新页面重试。'
      } finally {
        this.loading = false
      }
    }
  }

  if (walineConfig.enable) customElements.define('comment-component', Comment)
</script>

<style>
  #waline[data-hide-meta='true'] :global(.wl-meta) {
    display: none;
  }

  /* Basic theme */
  #waline {
    /* Font size */
    --waline-font-size: 16px;
    /* Basic color */
    --waline-white: hsl(var(--background) / var(--un-bg-opacity, 1));
    --waline-light-grey: #999;
    --waline-dark-grey: #666;
    /* Theme color */
    --waline-theme-color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    --waline-active-color: hsl(var(--primary) / var(--un-text-opacity, 1));
    /* Layout */
    --waline-color: hsl(var(--muted-foreground) / var(--un-text-opacity, 1));
    --waline-bg-color: hsl(var(--muted) / var(--un-bg-opacity, 1));
    --waline-bg-color-light: hsl(var(--input) / var(--un-text-opacity, 1));
    --waline-bg-color-hover: #f0f0f0;
    --waline-border-color: hsl(var(--border) / var(--un-border-opacity, 1));
    --waline-disable-bg-color: #f8f8f8;
    --waline-disable-color: #bbb;
    --waline-code-bg-color: #282c34;
    /* Special */
    --waline-bq-color: #f0f0f0;
    /* Avatar */
    --waline-avatar-size: 3.25rem;
    --waline-m-avatar-size: calc(var(--waline-avatar-size) * 9 / 13);
    /* Badge */
    --waline-badge-color: hsl(var(--border) / var(--un-border-opacity, 1));
    --waline-badge-font-size: 0.775em;
    /* Info */
    --waline-info-bg-color: var(--waline-bg-color-light);
    --waline-info-color: var(--waline-color);
    --waline-info-font-size: 0.625em;
    /* Render selection */
    --waline-border: 1px solid var(--waline-border-color);
    --waline-avatar-radius: 50%;
    --waline-box-shadow: none;
  }

  /* Fix long text and links overflow */
  #waline :global(.wl-content, .wl-text, .wl-comment-text, .wl-item, .wl-card-item) {
    max-width: 100%;
  }
  #waline :global(.wl-meta, .wl-content, .wl-text, .wl-comment-text) {
    word-wrap: break-word;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  /* Reaction buttons */
  #waline :global(.wl-reaction-title, .wl-reaction-text) {
    display: none;
  }
  #waline :global(.wl-reaction) {
    overflow: visible;
    margin-bottom: 0.5em;
  }
  #waline :global(.wl-reaction-img) {
    width: auto;
    display: flex;
    height: 35px;
    align-items: center;
    column-gap: 0.4rem;
  }
  #waline :global(.wl-reaction-votes) {
    position: inherit;
    top: inherit;
    min-width: inherit;
    inset-inline-end: inherit;
    display: flex;
    font-weight: normal;
    border: none;
    background: none;
    color: inherit;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
  }
  #waline :global(.wl-reaction-loading) {
    position: inherit;
    top: inherit;
    min-width: inherit;
  }
  #waline :global(.wl-reaction-item.active .wl-reaction-votes) {
    background: var(--waline-theme-color);
    color: var(--waline-bg-color);
  }
  #waline :global(.wl-reaction-votes:after) {
    margin-left: 0.25em;
    content: 'Like(s)';
    display: inline-block;
    clear: both;
    border: 0;
  }
  #waline :global(.wl-reaction img) {
    filter: invert(25%);
  }
  :global(.dark) #waline :global(.wl-reaction img) {
    filter: invert(75%);
  }
</style>
