---
import type { MarkdownHeading } from 'astro'
import { getImage } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import config from 'virtual:config'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Copyright, Hero, TOC } from 'astro-pure/components/pages'
import type { SiteMeta } from 'astro-pure/types'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment, PageInfo } from '@/components/waline'
import { splitGithubCards } from '@/utils/github-cards'
import { motion } from '@/site-config'

import GithubCard from '../../packages/pure/components/advanced/GithubCard.astro'

interface Props {
  post: CollectionEntry<'blog' | 'blogEn'>
  posts: CollectionEntry<'blog' | 'blogEn'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data, body },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const { description, heroImage, publishDate, title, draft: isDraft, comment } = data

const enableComment = comment && config.integ.waline.enable

let socialImage: SiteMeta['ogImage'] = config.socialCard
if (heroImage) {
  if (typeof heroImage.src === 'string') {
    socialImage = heroImage.src
  } else {
    // Keep the share-card ratio without asking Astro to enlarge a smaller source.
    const scale = Math.min(1, heroImage.src.width / 1200, heroImage.src.height / 630)
    const width = Math.max(1, Math.floor(1200 * scale))
    const height = Math.max(1, Math.floor(630 * scale))
    const { src } = await getImage({
      src: heroImage.src,
      width,
      height,
      fit: 'cover',
      position: 'attention',
      format: 'jpg',
      quality: 80
    })
    socialImage = { src, width, height }
  }
}
const articleDate = publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-bg-opacity, 1))'
const contentParts = body?.includes('<github-card')
  ? splitGithubCards(await Astro.slots.render('default'))
  : null
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back='/blog'
>
  {!!headings.length && <TOC {headings} slot='sidebar' />}

  <Hero {data} {remarkPluginFrontmatter} slot='header'>
    <Fragment slot='description'>
      {!isDraft && enableComment && <PageInfo comment class='mt-1' />}
    </Fragment>
  </Hero>

  {
    contentParts ? (
      contentParts.map((part) =>
        part.type === 'repo' ? (
          <GithubCard repo={part.repo} description={part.description} />
        ) : (
          <Fragment set:html={part.html} />
        )
      )
    ) : (
      <slot />
    )
  }

  <Fragment slot='bottom'>
    {/* Kept out of the animated body: a transformed ancestor would unpin this fixed bar */}
    {motion.readingProgress && <div class='reading-progress' aria-hidden='true' />}
    {/* Copyright */}
    <Copyright {data} />
    {/* Article recommend */}
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    {/* Comment */ !isDraft && enableComment && <Comment class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<style>
  /* Measured like the back-to-top percentage: empty when the body reaches the top of the
     screen, full when its end reaches the bottom. Scroll-driven with no script; browsers
     without support show no bar. Longhands only: the CSS minifier would fold the timeline
     into an `animation` shorthand, which browsers reject. */
  .reading-progress {
    display: none;
  }
  @supports (animation-timeline: view()) and (timeline-scope: --article) {
    :global(html) {
      timeline-scope: --article;
    }
    :global(#content) {
      view-timeline: --article block;
    }
    .reading-progress {
      display: block;
      position: fixed;
      inset-inline: 0;
      top: env(safe-area-inset-top, 0px);
      z-index: 60;
      height: 2px;
      pointer-events: none;
      background-color: color-mix(
        in srgb,
        var(--highlightColor, hsl(var(--primary))) 40%,
        hsl(var(--foreground))
      );
      transform-origin: 0 50%;
      animation-name: reading-progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --article;
      animation-range: contain 0% contain 100%;
    }
  }
  @keyframes reading-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
