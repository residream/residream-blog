---
import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'applications', text: 'Applications' },
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <img
      src='https://ghchart.rshah.org/659eb9/residream'
      alt='github activities'
      width='663'
      height='104'
      decoding='async'
      loading='lazy'
    />
  </p>
  <p>
    If you think it would be useful or interesting to collaborate on a project, you can donate to
    support my work or contact me to discuss a project.
  </p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='applications'>Applications</h2>
  <ProjectSection
    projects={[
      {
        name: '📝 Residream の blog',
        description: 'A blog, built with Astro and Astro Theme Pure',
        links: [
          { type: 'github', href: 'https://github.com/residream/residream-blog' },
          { type: 'site', href: 'https://residream.com' }
        ]
      }
    ]}
  />
  <Collapse title='Private projects'>
    <ProjectSection
      projects={[
        {
          name: '💬 Waline Comment System',
          description: 'Self-hosted comments for this blog, powered by Waline',
          links: [{ type: 'site', href: 'https://waline.residream.com' }]
        },
        {
          name: '📈 Visitor analytics',
          description: 'Self-hosted web analytics, powered by Counterscale',
          links: [{ type: 'site', href: 'https://stats.residream.com' }]
        },
        {
          name: '📊 Website status',
          description: 'Uptime monitoring and a public status page, powered by UptimeFlare',
          links: [{ type: 'site', href: 'https://status.residream.com' }]
        },
        {
          name: '🪄 Online tools',
          description: 'Encoding, decoding and data analysis tools, powered by CyberChef',
          links: [{ type: 'site', href: 'https://chef.residream.com' }]
        }
      ]}
    />
  </Collapse>

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🏥 HIS Course Design',
        description: 'A C-based Hospital Information System for JLU course design',
        links: [{ type: 'github', href: 'https://github.com/residream/his-course-design' }]
      }
    ]}
  />

  <h2 id='sponsorship'>Sponsorship</h2>
  <p>If my notes or writeups helped you, a coffee is always welcome.</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <p>
    Please leave a message or contact me after sponsorship:
    <a href='mailto:me@residream.dev'>me@residream.dev</a>
  </p>
</PageLayout>
