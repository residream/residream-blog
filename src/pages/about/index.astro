---
import { Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} comment>
  <p>Undergraduate / Developer</p>
  <p>
    Hello! I'm an undergraduate student majoring in cybersecurity at Jilin University. I'm mainly
    into web security — CTF web challenges and some penetration testing. Here I share writeups and
    learning notes. Welcome to visit!
  </p>
  <p>
    <Spoiler>{'flag{w3lc0m3_t0_my_bl0g}'}</Spoiler>
  </p>

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <p>You can find me on these platforms:</p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/residream',
        text: 'followers',
        api: 'github/residream'
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/id/residream',
        text: 'games',
        api: 'steamgames/76561199512347012'
      },
      {
        platform: 'Bilibili',
        icon: 'bilibili',
        color: '#ff6699',
        link: 'https://space.bilibili.com/310242000',
        text: 'followers',
        api: 'bilibili/310242000',
        count: 84
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/id/residream',
        text: 'friends',
        api: 'steamfriends/76561199512347012'
      }
    ]}
  />

  {/* education */}
  <h2 id='education'>Education</h2>
  <Timeline
    events={[{ date: '2025-09', content: '吉林大学，计算机科学与技术学院，网络空间安全，本科' }]}
  />

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>Current support tools as follow:</p>
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown Editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Debian 13',
        description: 'Linux Distribution',
        href: 'https://www.debian.org/',
        icon: import('@/assets/tools/debian.svg?raw')
      },
      {
        name: 'Ubuntu 24.04 LTS',
        description: 'Linux Distribution',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      },
      {
        name: 'MacOS',
        description: 'MacBook Air',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw')
      },
      {
        name: 'Windows 11',
        description: 'ROG Zephyrus G14',
        href: 'https://news.microsoft.com/windows11-general-availability/',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>Website history:</p>
  <Timeline
    events={[
      {
        date: '2026-02',
        content:
          'First blog launched with <a href="https://wordpress.org/" target="_blank">WordPress</a> and <a href="https://github.com/solstice23/argon-theme" target="_blank">Argon Theme</a>'
      },
      {
        date: '2026-09',
        content:
          'Rebuilt with <a href="https://astro.build/" target="_blank">Astro</a> and <a href="https://github.com/cworld1/astro-theme-pure" target="_blank">Astro Theme Pure</a>'
      }
    ]}
  />
  <p>
    The smooth operation and personalized customization of website also rely on the resources and
    technical support provided by the following excellent projects/service providers:
  </p>
  <ul>
    <li>
      Domain: <a href='https://wanwang.aliyun.com/' target='_blank'>Aliyun</a>
    </li>
    <li>
      Site hosting: <a href='https://www.aliyun.com/product/ecs' target='_blank'>Aliyun ECS</a>
    </li>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Other statistics: <a href='https://github.com/spencerwooo/substats' target='_blank'
        >Substats</a
      >
    </li>
  </ul>
</PageLayout>
