---
const { content, class: className, ...props } = Astro.props
---

<div id='qrcode-container' class={className} data-content={content} {...props}></div>

<script>
  // Draw the code once it nears the viewport; the encoder is loaded only then
  const container = document.getElementById('qrcode-container')
  let drawn = false

  async function draw(element: HTMLElement) {
    const { renderSVG } = await import('uqr')
    element.innerHTML = renderSVG(element.dataset.content || window.location.href, {
      ecc: 'M',
      border: 2
    })
    drawn = true
  }

  if (container) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        void draw(container)
      },
      { rootMargin: '200px 0px' }
    )
    observer.observe(container)
    if (!container.dataset.content)
      document.addEventListener('rd:language-change', () => {
        if (drawn) void draw(container)
      })
  }
</script>

<style>
  #qrcode-container :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
