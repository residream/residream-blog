---
import { cn } from '../../utils'

const { class: className, sentence } = Astro.props
---

<quote-component data-sentence={sentence} class={cn('not-prose inline-block', className)}>
  <div class='flex flex-row items-center gap-x-3 rounded-full border px-4 py-2 text-sm shadow-sm'>
    <span class='relative flex items-center justify-center'>
      <span
        class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
      ></span>
      <span class='size-2 rounded-full bg-green-400'></span>
    </span>
    <p id='quote-sentence' class='font-medium text-muted-foreground'>Loading...</p>
  </div>
</quote-component>

<script>
  import config from 'virtual:config'

  const { quote } = config.integ

  class Quote extends HTMLElement {
    // Bumped per request, so a slow answer cannot replace a newer one
    request = 0

    render(sentence: string) {
      const quoteEl = this.querySelector('#quote-sentence') as HTMLElement
      if (!quoteEl) return
      quoteEl.innerText = sentence
    }

    load = async () => {
      if (this.dataset.sentence) {
        this.render(this.dataset.sentence)
        return
      }
      const request = ++this.request
      // Pages in another language can have their own source, keyed by <html lang>
      const source = quote.locales?.[document.documentElement.lang] ?? quote
      let sentence: unknown
      try {
        const response = await fetch(source.server, { signal: AbortSignal.timeout(3000) })
        // Because virtual:config can only be accessed using json string, function cannot work, so we need to use new Function
        const targetFunction = new Function('data', `return (${source.target})(data)`)
        sentence = targetFunction(await response.json())
      } catch {
        // Falls back to the site description below
      }
      if (request !== this.request) return
      this.render(typeof sentence === 'string' && sentence ? sentence : config.description)
    }

    connectedCallback() {
      // The language switch keeps this element, so it fetches a quote in the new language itself
      document.addEventListener('rd:language-change', this.load)
      void this.load()
    }

    disconnectedCallback() {
      document.removeEventListener('rd:language-change', this.load)
    }
  }
  customElements.define('quote-component', Quote)
</script>

<style>
  /* UnoCSS presetMini has no animation utilities, so the status dot's pulse is defined here */
  .animate-ping {
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-ping {
      animation: none;
    }
  }
</style>
