---
import { Icon } from '../user'

interface Props {
  repo?: string
}

const { repo: repoRaw = '' } = Astro.props

// Remove 'https://github.com/' headings from the repo string
const repo = repoRaw.replace(/^https:\/\/github\.com\//, '')

const [owner = '', repoName = ''] = repo.split('/')
const Wrapper = repo ? 'github-card' : 'template'
---

<Wrapper
  class={repo ? 'not-prose loading' : undefined}
  data-repo={repo || undefined}
  data-github-card-template={!repo || undefined}
>
  <a
    href={`https://github.com/${repo}`}
    target='_blank'
    rel='noopener noreferrer'
    class='group block flex flex-col gap-y-2 rounded-xl border px-4 py-3 transition-colors hover:bg-muted hover:text-muted-foreground sm:px-5 sm:py-4'
  >
    <div class='flex items-center justify-between gap-x-2'>
      <div
        class='flex min-w-0 flex-1 items-center gap-x-2 text-foreground group-hover:text-primary'
      >
        <div
          data-gh='avatar'
          class='load-block me-2 size-7 flex-shrink-0 bg-cover sm:size-8'
          style='border-radius:999px'
        >
        </div>
        <div class='min-w-0 flex-1'>
          <div class='flex items-center gap-x-1 max-sm:flex-wrap'>
            <span data-gh='owner' class='truncate text-base transition-colors sm:text-lg'
              >{owner}</span
            >
            <span class='text-muted-foreground max-sm:hidden'>/</span>
            <span
              data-gh='name'
              class='truncate text-base font-medium transition-colors sm:text-lg max-sm:w-full'
              >{repoName}</span
            >
          </div>
        </div>
      </div>
      <div class='flex-shrink-0 rounded-full bg-card p-1'>
        <Icon name='github' />
      </div>
    </div>
    <p data-gh='description' class='load-block text-sm sm:text-base'>查看 GitHub 项目</p>
    <div class='flex items-center justify-between gap-x-2'>
      <div class='load-block flex flex-wrap items-center gap-x-3 gap-y-1 sm:gap-x-5'>
        <div class='flex items-center gap-x-1.5 sm:gap-x-2'>
          {/* mingcute:star-line */}

          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='20'
            height='20'
            viewBox='0 0 24 24'
            class='sm:w-[22px] sm:h-[22px]'
            ><g fill='none' fill-rule='evenodd'
              ><path
                d='m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z'
              ></path><path
                fill='currentColor'
                d='M10.92 2.868a1.25 1.25 0 0 1 2.16 0l2.795 4.798l5.428 1.176a1.25 1.25 0 0 1 .667 2.054l-3.7 4.141l.56 5.525a1.25 1.25 0 0 1-1.748 1.27L12 19.592l-5.082 2.24a1.25 1.25 0 0 1-1.748-1.27l.56-5.525l-3.7-4.14a1.25 1.25 0 0 1 .667-2.055l5.428-1.176zM12 4.987L9.687 8.959a1.25 1.25 0 0 1-.816.592l-4.492.973l3.062 3.427c.234.262.347.61.312.959l-.463 4.573l4.206-1.854a1.25 1.25 0 0 1 1.008 0l4.206 1.854l-.463-4.573a1.25 1.25 0 0 1 .311-.959l3.063-3.427l-4.492-.973a1.25 1.25 0 0 1-.816-.592z'
              ></path></g
            ></svg
          >

          <span data-gh='stars' class='text-sm leading-tight sm:text-base'>—</span>
        </div>

        <div class='flex items-center gap-x-1.5 sm:gap-x-2'>
          {/* mingcute:git-branch-line */}

          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='20'
            height='20'
            viewBox='0 0 24 24'
            class='sm:w-[22px] sm:h-[22px]'
            ><g fill='none'
              ><path
                d='m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z'
              ></path><path
                fill='currentColor'
                d='M18 3a3 3 0 0 1 1 5.83V9a4 4 0 0 1-4 4H9a2 2 0 0 0-2 2v.17a3.001 3.001 0 1 1-2 0V8.83a3.001 3.001 0 1 1 2 0v2.705A4 4 0 0 1 9 11h6a2 2 0 0 0 2-2v-.17A3.001 3.001 0 0 1 18 3M6 17a1 1 0 1 0 0 2a1 1 0 0 0 0-2M6 5a1 1 0 1 0 0 2a1 1 0 0 0 0-2m12 0a1 1 0 1 0 0 2a1 1 0 0 0 0-2'
              ></path></g
            ></svg
          >

          <span data-gh='forks' class='text-sm leading-tight sm:text-base'>—</span>
        </div>

        <div class='flex items-center gap-x-1.5 sm:gap-x-2'>
          {/* mingcute:balance-line */}

          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='20'
            height='20'
            viewBox='0 0 24 24'
            class='sm:w-[22px] sm:h-[22px]'
            ><g fill='none' fill-rule='evenodd'
              ><path
                d='m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z'
              ></path><path
                fill='currentColor'
                d='M12 3a1 1 0 0 1 1 1v1h.764a2 2 0 0 1 .894.211L16.236 6H20a1 1 0 1 1 0 2h-.382l2.276 4.553c.07.139.106.292.106.447a4 4 0 0 1-8 0c0-.155.036-.308.106-.447L16.382 8h-.146a2 2 0 0 1-.894-.211L13.764 7H13v12h3a1 1 0 1 1 0 2H8a1 1 0 1 1 0-2h3V7h-.764l-1.578.789A2 2 0 0 1 7.764 8h-.146l2.276 4.553A1 1 0 0 1 10 13a4 4 0 0 1-8 0a1 1 0 0 1 .106-.447L4.382 8H4a1 1 0 0 1 0-2h3.764l1.578-.789A2 2 0 0 1 10.236 5H11V4a1 1 0 0 1 1-1M6 9.236l-1.989 3.977a2 2 0 0 0 3.978 0zm12 0l-1.989 3.977a2 2 0 0 0 3.955.157l.023-.156z'
              ></path></g
            ></svg
          >
          <span data-gh='license' class='text-sm leading-tight sm:text-base'>—</span>
        </div>
      </div>
      <span data-gh='language' class='load-block text-sm leading-tight sm:text-base'>GitHub</span>
    </div>
  </a>
</Wrapper>

<style is:global>
  github-card {
    display: block;
    margin-block: 1rem;
  }
  @keyframes github-card-pulsate {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
    to {
      opacity: 1;
    }
  }
  github-card.loading .load-block {
    color: transparent;
    border-radius: calc(var(--radius) - 3px);
    background-color: hsl(var(--card) / var(--un-bg-opacity, 1));
    animation: github-card-pulsate 2s infinite linear;
    user-select: none;
  }
  github-card.loading .load-block:nth-child(2) {
    animation-delay: 1s;
  }
  github-card .no-license {
    opacity: 0.5;
  }
  github-card:not(.loading) [data-gh='avatar'] {
    background-color: hsl(var(--card) / var(--un-bg-opacity));
  }
</style>

<script>
  interface GithubProps {
    stargazers_count: number
    forks: number
    language: string
    owner: { avatar_url: string }
    license?: { spdx_id: string }
    description: string
  }

  class GithubCard extends HTMLElement {
    async fetchGithub(repo: string): Promise<GithubProps | null> {
      try {
        const res = await fetch(`https://api.github.com/repos/${repo}`, {
          referrerPolicy: 'no-referrer',
          signal: AbortSignal.timeout(8000)
        })
        if (!res.ok) {
          throw new Error(`HTTP error! status: ${res.status}`)
        }
        return (await res.json()) as GithubProps
      } catch (e) {
        console.error('Failed to fetch Github data:', e)
        return null
      }
    }

    numberFormat(value: number): string {
      return Intl.NumberFormat('en-us', {
        notation: 'compact',
        maximumFractionDigits: 1
      }).format(value)
    }

    async connectedCallback() {
      const repo = this.dataset.repo
      if (!repo || !/^[\w.-]+\/[\w.-]+$/.test(repo) || this.dataset.initialized) return

      if (!this.querySelector('[data-gh="description"]')) {
        const template = document.querySelector<HTMLTemplateElement>('[data-github-card-template]')
        if (!template) return
        this.replaceChildren(template.content.cloneNode(true))
      }

      this.dataset.initialized = 'true'
      this.classList.add('not-prose', 'loading')
      const [owner, name] = repo.split('/')
      this.updateElement('[data-gh="owner"]', owner)
      this.updateElement('[data-gh="name"]', name)
      this.querySelector('a')!.href = `https://github.com/${repo}`

      try {
        const data = await this.fetchGithub(repo)
        if (!data) return
        // Update stats
        this.updateElement('[data-gh="stars"]', this.numberFormat(data.stargazers_count))
        this.updateElement('[data-gh="forks"]', this.numberFormat(data.forks))
        this.updateElement('[data-gh="language"]', data.language || 'N/A')
        // Update description
        const description =
          typeof data.description === 'string'
            ? data.description.replace(/:[a-zA-Z0-9_]+:/g, '')
            : 'Description not set'
        this.updateElement('[data-gh="description"]', description)
        // Update license
        const licenseText = data.license?.spdx_id || 'N/A'
        const licenseEl = this.querySelector('[data-gh="license"]') as HTMLElement
        licenseEl.textContent = licenseText
        licenseEl.classList.toggle('no-license', licenseText === 'N/A')
        // Update avatar
        const avatarEl = this.querySelector('[data-gh="avatar"]') as HTMLElement
        if (avatarEl) {
          avatarEl.style.backgroundImage = `url(${data.owner.avatar_url})`
        }
      } catch (e) {
        console.error('Error setting Github data:', e)
      } finally {
        this.classList.remove('loading')
      }
    }

    private updateElement(selector: string, text: string) {
      const element = this.querySelector(selector) as HTMLElement
      if (element) {
        element.textContent = text
      }
    }
  }

  if (!customElements.get('github-card')) customElements.define('github-card', GithubCard)
</script>
