# Copy to .deploy.env (git-ignored) and fill in. Used by scripts/deploy.sh.

# SSH destination of the web server: user@address, or a Host alias from ~/.ssh/config.
DEPLOY_HOST=user@server

# Optional overrides (defaults shown).
# SITE_HOST=residream.com
# WEB_ROOT=/var/www/residream-blog

# Optional image libraries; colon-separated folders, searched recursively.
# By default the importer searches next to the Markdown (including subfolders),
# then these libraries, the existing post, and the project's assets/blog images.
# Missing files or different images with the same name stop the import with a clear error.
# IMAGE_DIRS="$HOME/Pictures/illustrations"

# Local folder for `bun run backup`, which copies the server's daily and weekly backups
# to this Mac. The secrets archive stays on the server and is never copied.
# BACKUP_DIR="$HOME/Backups/residream-server"

# Optional: purge the Cloudflare cache after each deploy.
# Zone ID: Cloudflare dashboard → residream.com → Overview → API → Zone ID.
# CF_ZONE_ID=
# The API token (permission: Zone → Cache Purge → Purge, for this zone only) is read from
# $CF_API_TOKEN, or from the macOS keychain item created with (it prompts for the token):
#   security add-generic-password -a "$USER" -s residream-cf-purge -w
